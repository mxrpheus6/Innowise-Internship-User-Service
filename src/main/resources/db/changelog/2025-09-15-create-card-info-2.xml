<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

  <changeSet id="2" author="you">
    <createTable tableName="card_info">
      <column name="id" type="BIGSERIAL">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="user_id" type="BIGINT">
        <constraints nullable="false" foreignKeyName="fk_card_user"
          referencedTableName="users" referencedColumnNames="id"/>
      </column>
      <column name="number" type="VARCHAR(20)">
        <constraints nullable="false"/>
      </column>
      <column name="holder" type="VARCHAR(100)"/>
      <column name="expiration_date" type="DATE"/>
    </createTable>

    <createIndex tableName="card_info" indexName="idx_card_user_id">
      <column name="user_id"/>
    </createIndex>

    <createIndex tableName="card_info" indexName="idx_card_number" unique="true">
      <column name="number"/>
    </createIndex>
  </changeSet>

</databaseChangeLog>
